{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/supeesu/calendar/v1",
  "title": "Supeesu Scene Zero ecological calendar v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "calendarId",
    "epochLocalDate",
    "dateBasis",
    "ecologyCycleDays",
    "ecologicalSeasons",
    "rhythms",
    "microseasonPlan",
    "annualEvents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "calendarId": {
      "type": "string",
      "minLength": 1
    },
    "epochLocalDate": {
      "$ref": "#/$defs/civilDate"
    },
    "dateBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldDay",
        "sessionDay",
        "timeZone",
        "preEpoch"
      ],
      "properties": {
        "worldDay": {
          "const": "local-civil-midnight"
        },
        "sessionDay": {
          "const": "separate-05:30-local-boundary"
        },
        "timeZone": {
          "const": "host-local-time-zone"
        },
        "preEpoch": {
          "const": "continuous-cycle"
        }
      }
    },
    "ecologyCycleDays": {
      "const": 800
    },
    "ecologicalSeasons": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/season"
      }
    },
    "rhythms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microseasonDays",
        "shortCycleDays",
        "longCycleDays"
      ],
      "properties": {
        "microseasonDays": {
          "const": 7
        },
        "shortCycleDays": {
          "const": 200
        },
        "longCycleDays": {
          "const": 400
        }
      }
    },
    "microseasonPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "coverageDays",
        "profileCount",
        "phasePolicy",
        "outsideCoverage",
        "status"
      ],
      "properties": {
        "source": {
          "const": "source/microseasons_first_200_days.original.json"
        },
        "coverageDays": {
          "const": 200
        },
        "profileCount": {
          "const": 29
        },
        "phasePolicy": {
          "const": "continuous-from-epoch"
        },
        "outsideCoverage": {
          "const": "unassigned"
        },
        "status": {
          "const": "design"
        }
      }
    },
    "lunarCycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lunar"
      }
    },
    "annualEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "dailyMarkers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "localTime",
          "label",
          "status"
        ],
        "properties": {
          "localTime": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "design",
              "canonical"
            ]
          }
        }
      }
    },
    "futureSystems": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sourceProvenance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "civilDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "normalized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "durationDays",
        "targets",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "durationDays": {
          "const": 100
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "moisture",
            "radiance",
            "biologicalActivity"
          ],
          "properties": {
            "moisture": {
              "$ref": "#/$defs/normalized"
            },
            "radiance": {
              "$ref": "#/$defs/normalized"
            },
            "biologicalActivity": {
              "$ref": "#/$defs/normalized"
            }
          }
        },
        "status": {
          "enum": [
            "design",
            "canonical"
          ]
        }
      }
    },
    "lunar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "enum": [
            "verified-ephemeris-required",
            "independent-period"
          ]
        },
        "periodDays": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "design",
            "not-implemented",
            "canonical"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "month",
        "day",
        "status",
        "developmentOnly"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "status": {
          "enum": [
            "canonical",
            "provisional"
          ]
        },
        "developmentOnly": {
          "type": "boolean"
        }
      }
    }
  }
}
